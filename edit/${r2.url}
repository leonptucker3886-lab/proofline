<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Proofline — Before &amp; after photo reports for trades</title>
<meta name="description" content="Photograph the job before and after. Send customers a branded proof report. Dispute armor, upsell proof, five-star fuel. From Proofline at leonlink.net.">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0c0b09;--panel:#16130e;--line:#2b261c;--muted:#9a9080;--text:#f2ece0;--accent:#e8963c;--accent-ink:#191405}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 -apple-system,'Segoe UI',Roboto,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:Fraunces,Georgia,serif;letter-spacing:-.02em;line-height:1.12;margin:0 0 12px}
a{color:var(--accent)}
button,.btn{background:var(--accent);color:var(--accent-ink);border:0;border-radius:10px;padding:12px 20px;font-size:15px;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px}
.btn.ghost{background:transparent;color:var(--text);border:1px solid var(--line)}
.btn.small{padding:8px 14px;min-height:36px;font-size:13.5px}
input,textarea{width:100%;background:#0f0d0a;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:12px;font-size:15px}
input:focus,textarea:focus{outline:1px solid var(--accent)}
textarea{min-height:110px;resize:vertical}
.wrap{max-width:980px;margin:0 auto;padding:0 18px}
.hide-m{}
/* header */
header{position:sticky;top:0;z-index:6;background:rgba(12,11,9,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar{height:56px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--text);font-weight:800}
.brand img{width:30px;height:30px;border-radius:50%;object-fit:cover;border:2px solid var(--accent)}
.brand span{font-family:Fraunces,Georgia,serif}
nav.links{display:flex;gap:14px;align-items:center}
nav.links a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:600}
nav.links a:hover{color:var(--accent)}
nav.links a.hl{color:var(--accent);font-weight:700}
@media(max-width:640px){nav.links a.hh{display:none}}
/* landing */
.landing-hero{padding:56px 0 40px;text-align:center;background:radial-gradient(1000px 420px at 50% -140px,rgba(232,150,60,.09),transparent)}
.landing-hero h1{font-size:clamp(30px,5.4vw,50px);max-width:19em;margin:14px auto 16px}
.landing-hero .lede{color:var(--muted);max-width:36em;margin:0 auto 26px;font-size:clamp(15px,2.2vw,18px)}
.landing-hero .cta-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:14px}
.faint{color:var(--muted);font-size:13px}
section.blocks{padding:36px 0}
section.blocks h2{font-size:clamp(22px,3.4vw,30px)}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:18px}
.card h3{font-size:18px;margin-bottom:6px}
.card p{color:var(--muted);font-size:14px;margin:0;line-height:1.55}
footer{border-top:1px solid var(--line);padding:34px 0;text-align:center;color:var(--muted);font-size:13.5px}
footer img{width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid var(--accent);margin-bottom:10px}
/* app views */
.appbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:26px 0 16px;flex-wrap:wrap}
.appbar h2{margin:0;font-size:24px}
.reports{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
.rep{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px}
.rep strong{font-family:Fraunces,Georgia,serif;font-size:17px}
.rep .meta{color:var(--muted);font-size:13px}
.rep .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.field{margin-bottom:14px}
label{display:block;font-size:13px;font-weight:700;color:var(--muted);margin-bottom:6px}
/* editor */
.shot-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin:10px 0 6px}
.shot{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--line);aspect-ratio:1;background:#0f0d0a}
.shot img{width:100%;height:100%;object-fit:cover;display:block}
.shot .x{position:absolute;top:6px;right:6px;width:26px;height:26px;border-radius:8px;background:rgba(0,0,0,.72);color:#fff;border:0;cursor:pointer;font-size:14px;line-height:1}
.shot .busy{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6);font-size:12px;color:#ffd9a8}
.uprow{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.share-box{background:var(--panel);border:1px dashed var(--line);border-radius:12px;padding:14px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:16px 0}
.share-box code{font-size:13px;color:var(--accent);word-break:break-all;flex:1;min-width:200px}
/* public share page */
.pub{max-width:760px;margin:0 auto;padding:30px 18px 60px}
.pub .head{text-align:center;margin-bottom:22px}
.pub .head img.mark{width:64px;height:64px;border-radius:50%;border:2px solid var(--accent);object-fit:cover}
.pub h1{font-size:clamp(24px,4.4vw,36px);margin:12px 0 4px}
.pub .when{color:var(--muted);font-size:14px;margin-bottom:6px}
.ba{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:640px){.ba{grid-template-columns:1fr}}
.ba .col h3{text-align:center;font-size:15px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin:0 0 10px}
.ba .col.before h3{color:var(--muted)}
.stack{display:flex;flex-direction:column;gap:10px}
.stack img{width:100%;border-radius:12px;border:1px solid var(--line);display:block}
.note-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin:22px 0;line-height:1.6}
.review-cta{text-align:center;margin:26px 0 10px}
@media print{header,footer,.review-cta,.pub .head img.mark{display:none}body{background:#fff;color:#000}.pub h1{color:#000}.note-card{border-color:#ccc;background:#fff}.stack img{border-color:#ccc}}
/* auth */
.auth{max-width:400px;margin:48px auto;padding:0 18px}
.auth h2{text-align:center}
.err{color:#ff9d7a;font-size:14px;min-height:20px;margin:8px 0}
</style></head><body>
<div id="app"></div>
<script>
const api = (a, body) => fetch('/api?a=' + a, body ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) } : {}).then(async r => { const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.error || 'Something went wrong'); return j; });
const esc = s => String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const app = document.getElementById('app');
let S = { user: null, reports: [], counts: {}, photos: null, cur: null, view: 'dashboard', pub: null, err: '' };
const $ = s => document.querySelector(s);

function header(navLinks) {
  return `<header><div class="wrap bar">
    <a class="brand" href="/"><img src="/mascot.png" alt="">Proofline</a>
    <nav class="links">${navLinks}</nav>
  </div></header>`;
}
function shell(content) {
  app.innerHTML = header(`<a class="hh" href="/reports">Reports</a><a class="hh" href="/settings">Settings</a><a class="hh" href="https://www.leonlink.net">Leon&nbsp;Link</a><a class="hl" href="#" id="logout">Log out</a>`) + `<main class="wrap">${content}</main>
  <footer><img src="/mascot.png" alt=""><br>Proofline — before &amp; after proof for trades. A <a href="https://www.leonlink.net">Leon Link</a> product.<br>© ${new Date().getFullYear()} Leon Link</footer>`;
  const lo = $('#logout'); if (lo) lo.onclick = () => api('pl-logout').catch(() => {}).finally(() => { location.href = '/login'; });
}

async function boot() {
  const p = location.pathname;
  const m = p.match(/^\/r\/([a-f0-9]+)/);
  if (m) return pubView(m[1]);
  try { const st = await api('pl-state'); S.user = st.user; S.reports = st.reports; S.counts = st.counts || {}; }
  catch (e) { S.user = null; }
  if (!S.user) {
    if (location.pathname === '/') return landingView();
    if (location.pathname !== '/login' && location.pathname !== '/signup') location.href = '/login';
    renderAuth(location.pathname === '/signup' ? 'signup' : 'login');
    return;
  }
  if (p === '/settings') return settingsView();
  if (p.startsWith('/edit/')) return editorView(p.split('/')[2]);
  dashboardView();
}

/* ---------- landing ---------- */
function landingView() {
  const sample = 'https://proofline.leonlink.net/r/522dcff87a334330781aca7f';
  app.innerHTML = header(`<a class="hh" href="#how">How it works</a><a class="hh" href="https://review.leonlink.net">Reviewline</a><a class="hh" href="https://app.leonlink.net">Ledgerline</a><a class="hh" href="/login">Log in</a><a class="hl" href="/signup">Sign up free</a>`) + `
  <main>
    <section class="landing-hero">
      <div class="wrap">
        <img src="/mascot.png" alt="Proofline mascot" style="width:132px;height:132px;border-radius:50%;object-fit:cover;border:3px solid var(--accent)">
        <h1>Every job, proven<br>with&nbsp;photos.</h1>
        <p class="lede">Photograph the mess when you arrive, photograph the work when you leave. Proofline turns the two into a clean before-and-after report your customer keeps — and shows everyone.</p>
        <div class="cta-row"><a class="btn" href="/signup">Start free — no card</a><a class="btn ghost" href="${sample}" target="_blank">See a sample report</a></div>
        <p class="faint">$5/mo — or free with Ledgerline's top tier · Works on your phone, on the job</p>
      </div>
    </section>
    <section class="blocks"><div class="wrap">
      <div class="grid3">
        <div class="card"><h3>Dispute armor</h3><p>"You damaged my…" — no, here's the timestamped before photo from when we arrived. Proof ends the argument before it starts.</p></div>
        <div class="card"><h3>Upsell proof</h3><p>That cracked flue tile you spotted? Photograph it, show it in the report. Customers say yes to what they can see.</p></div>
        <div class="card"><h3>Yours forever</h3><p>Every report is a clean page your customer can save, share, or print for their records. No app to install, no login to forget.</p></div>
      </div>
    </div></section>
    <section class="blocks" id="how"><div class="wrap">
      <h2 style="text-align:center">Three steps, ninety&nbsp;seconds</h2>
      <div class="grid3" style="margin-top:18px">
        <div class="card"><h3>1 · Snap the before</h3><p>Phone out at the truck. Add the shots to the job before you lift a tool.</p></div>
        <div class="card"><h3>2 · Snap the after</h3><p>Finished? Photograph the clean, completed work and drop in what you did.</p></div>
        <div class="card"><h3>3 · Send the link</h3><p>One text message. Your customer gets a branded page they can save, share, or print.</p></div>
      </div>
      <div style="text-align:center;margin-top:26px"><a class="btn" href="/signup">Create your first report</a></div>
    </div></section>
  </main>
  <footer><img src="/mascot.png" alt=""><br>Proofline — before &amp; after proof for trades. A <a href="https://www.leonlink.net">Leon Link</a> product.<br>© ${new Date().getFullYear()} Leon Link</footer>`;
}

/* ---------- auth ---------- */
function renderAuth(mode) {
  const signup = mode === 'signup';
  app.innerHTML = header(`<a class="hh" href="https://www.leonlink.net">Leon&nbsp;Link</a><a class="hh" href="https://review.leonlink.net">Reviewline</a><a class="hh" href="https://app.leonlink.net">Ledgerline</a>`) + `
  <div class="auth"><h2>${signup ? 'Create your Proofline account' : 'Log in to Proofline'}</h2>
  ${signup ? `<div class="field"><label>Business name</label><input id="biz" maxlength="120" placeholder="Chimney king"></div>` : ''}
  <div class="field"><label>Email</label><input id="email" type="email" placeholder="you@business.com"></div>
  <div class="field"><label>Password</label><input id="pw" type="password" placeholder="${signup ? 'At least 8 characters' : '••••••••'}"></div>
  <div class="err" id="err"></div>
  <button id="go" style="width:100%">${signup ? 'Create account' : 'Log in'}</button>
  <p class="faint" style="text-align:center;margin-top:14px">${signup ? 'Already have one? <a href="/login">Log in</a>' : 'New here? <a href="/signup">Create an account</a>'}</p></div>`;
  $('#go').onclick = async () => {
    $('#err').textContent = '';
    try {
      const body = { email: $('#email').value, password: $('#pw').value, biz: signup ? $('#biz').value : undefined };
      await api(signup ? 'pl-signup' : 'pl-login', body);
      location.href = '/dashboard';
    } catch (e) { $('#err').textContent = e.message; }
  };
  $('#pw').addEventListener('keydown', e => { if (e.key === 'Enter') $('#go').click(); });
}

/* ---------- dashboard ---------- */
async function dashboardView() {
  const st = await api('pl-state'); S.reports = st.reports; S.counts = st.counts || {}; S.user = st.user;
  const cards = S.reports.map(r => {
    const c = S.counts[r.id] || { before: 0, after: 0 };
    return `<div class="rep"><strong>${esc(r.title)}</strong><div class="meta">${esc(r.customer || 'No customer set')}${r.jobdate ? ' · ' + esc(r.jobdate) : ''}</div>
    <div class="meta">📷 ${c.before} before · 📷 ${c.after} after</div>
    <div class="row"><a class="btn small" href="/edit/${r.id}">Open</a><a class="btn small ghost" href="/r/${r.token}" target="_blank">View share page</a><button class="btn small ghost" data-del="${r.id}">Delete</button></div></div>`;
  }).join('');
  shell(`<div class="appbar"><h2>Your reports</h2><div style="display:flex;gap:10px"><button id="new">+ New report</button><a class="btn ghost" href="/settings">Settings</a></div></div>
  ${S.reports.length ? `<div class="reports">${cards}</div>` : `<div class="card" style="text-align:center;padding:44px 18px"><h3>No reports yet</h3><p>Every finished job becomes proof. Snap the before, do the work, snap the after — send the link.<br><br></p><button id="new2">Create your first report</button></div>`}`);
  const create = () => api('pl-save-report', { title: 'Untitled job' }).then(r => { location.href = '/edit/' + r.id; }).catch(e => alert(e.message));
  $('#new').onclick = create; const n2 = $('#new2'); if (n2) n2.onclick = create;
  document.querySelectorAll('[data-del]').forEach(b => b.onclick = () => { if (confirm('Delete this report and its photos?')) api('pl-del-report', { id: b.dataset.del }).then(boot).catch(e => alert(e.message)); });
}

/* ---------- editor ---------- */
async function editorView(id) {
  try { S.photos = await api('pl-photos', { reportId: id }); } catch (e) { return location.href = '/dashboard'; }
  const r = S.reports.find(x => x.id === id) || (await api('pl-state')).reports.find(x => x.id === id);
  if (!r) return location.href = '/dashboard';
  S.cur = r;
  const shareUrl = location.origin + '/r/' + r.token;
  const col = (kind, label, hint) => `
    <div class="card"><h3>${label}</h3>
      <p>${hint}</p>
      <div class="uprow"><button class="btn small" data-pick="${kind}">+ Add ${label.toLowerCase()} photos</button><span class="faint">JPG/PNG — resized automatically</span></div>
      <input type="file" accept="image/*" multiple hidden id="file-${kind}">
      <div class="shot-grid" id="grid-${kind}">${(S.photos[kind] || []).map(p => shot(p, kind)).join('')}</div>
    </div>`;
  function shot(p, kind) {
    return `<div class="shot" data-id="${p.id}"><img src="${p.url}" alt=""><button class="x" data-x="${p.id}" title="Delete">✕</button></div>`;
  }
  shell(`<div class="appbar"><h2>${esc(r.title)}</h2><div style="display:flex;gap:10px"><a class="btn ghost" href="/dashboard">All reports</a><a class="btn" href="/r/${r.token}" target="_blank">Open share page</a></div></div>
  <div class="share-box"><code id="sharelink">${shareUrl}</code><button class="btn small" id="copy">Copy link</button></div>
  <div class="field"><label>Job title</label><input id="f-title" maxlength="200" value="${esc(r.title)}"></div>
  <div class="grid3">
    <div class="field"><label>Customer (optional)</label><input id="f-cust" maxlength="120" value="${esc(r.customer)}" placeholder="Jane R."></div>
    <div class="field"><label>Date</label><input id="f-date" type="date" value="${esc(r.jobdate)}"></div>
  </div>
  <div class="field"><label>Work completed (shows on the share page)</label><textarea id="f-note" maxlength="4000" placeholder="Swept the flue, level-2 camera inspection, replaced crown cap…">${esc(r.note)}</textarea></div>
  <button id="save">Save details</button> <span class="faint" id="saved"></span>
  <div style="height:26px"></div>
  <div class="grid3">
    ${col('before', 'Before', 'The before shots — the honest condition when you arrived.')}
    ${col('after', 'After', 'The finished work. This is what sells the next job.')}
  </div>`);
  $('#copy').onclick = () => { navigator.clipboard.writeText(shareUrl).then(() => { $('#copy').textContent = 'Copied!'; setTimeout(() => $('#copy').textContent = 'Copy link', 1500); }); };
  $('#save').onclick = async () => {
    try {
      await api('pl-save-report', { id: r.id, title: $('#f-title').value, customer: $('#f-cust').value, jobdate: $('#f-date').value, note: $('#f-note').value });
      $('#saved').textContent = 'Saved ✓';
    } catch (e) { alert(e.message); }
  };
  document.querySelectorAll('[data-pick]').forEach(b => b.onclick = () => $('#file-' + b.dataset.pick).click());
  ['before', 'after'].forEach(kind => {
    const inp = $('#file-' + kind);
    inp.onchange = async () => {
      for (const f of inp.files) await uploadOne(kind, f);
      inp.value = '';
    };
  });
  document.querySelectorAll('[data-x]').forEach(b => b.onclick = () => { if (confirm('Delete this photo?')) api('pl-del-photo', { id: b.dataset.x }).then(() => location.reload()).catch(e => alert(e.message)); });
  async function uploadOne(kind, file) {
    const grid = $('#grid-' + kind);
    const ph = document.createElement('div'); ph.className = 'shot'; ph.innerHTML = '<div class="busy">Uploading…</div>'; grid.prepend(ph);
    try {
      const resized = await resize(file);
      const r2 = await api('pl-upload', { reportId: id, kind, data: resized.data, mime: 'image/jpeg' });
      ph.innerHTML = `<img src="${r2.url}" alt=""><button class="x" data-x="${r2.id}">✕</button>`;
      ph.querySelector('.x').onclick = () => { if (confirm('Delete this photo?')) api('pl-del-photo', { id: r2.id }).then(() => location.reload()).catch(e => alert(e.message)); };
    } catch (e) { ph.remove(); alert(e.message); }
  }
  function resize(file) {
    return new Promise((res, rej) => {
      const img = new Image();
      const fr = new FileReader();
      fr.onload = () => { img.src = fr.result; };
      img.onerror = rej;
      img.onload = () => {
        const max = 1600, sc = Math.min(1, max / Math.max(img.width, img.height));
        const c = document.createElement('canvas'); c.width = Math.round(img.width * sc); c.height = Math.round(img.height * sc);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        const data = c.toDataURL('image/jpeg', 0.82).split(',')[1];
        res({ data });
      };
      fr.onerror = rej;
      fr.readAsDataURL(file);
    });
  }
}

/* ---------- settings ---------- */
async function settingsView() {
  const st = await api('pl-state'); S.user = st.user;
  shell(`<div class="appbar"><h2>Settings</h2></div>
  <div class="card" style="max-width:520px">
    <div class="field"><label>Business name (shown on share pages)</label><input id="s-biz" maxlength="120" value="${esc(S.user.biz)}"></div>
    <button id="s-save">Save settings</button> <span class="faint" id="saved"></span>
  </div>`);
  $('#s-save').onclick = () => api('pl-save-settings', { biz: $('#s-biz').value }).then(() => { $('#saved').textContent = 'Saved ✓'; }).catch(e => alert(e.message));
}

/* ---------- public share page ---------- */
async function pubView(token) {
  app.innerHTML = `<main class="pub"><p class="faint" style="text-align:center;padding:60px 0">Loading…</p></main>`;
  try {
    const d = await api('pl-report-info', { t: token });
    const pile = arr => arr.length ? `<div class="stack">${arr.map(u => `<img src="${esc(u)}" alt="" loading="lazy">`).join('')}</div>` : `<p class="faint" style="text-align:center">No ${d.before === arr ? 'before' : 'after'} photos yet</p>`;
    app.innerHTML = header(`<a class="hh" href="https://www.leonlink.net">Leon&nbsp;Link</a><a class="hh" href="https://review.leonlink.net">Reviewline</a><a class="btn small ghost" href="#" onclick="window.print();return false">Print / PDF</a>`) + `
    <main class="pub">
      <div class="head">
        <img class="mark" src="/mascot.png" alt="">
        <h1>${esc(d.title)}</h1>
        <p class="when">${esc(d.biz)}${d.customer ? ' · for ' + esc(d.customer) : ''}${d.jobdate ? ' · ' + esc(d.jobdate) : ''}</p>
      </div>
      <div class="ba">
        <div class="col before"><h3>Before</h3>${pile(d.before)}</div>
        <div class="col"><h3>After</h3>${pile(d.after)}</div>
      </div>
      ${d.note ? `<div class="note-card"><b>Work completed</b><br>${esc(d.note).replace(/\n/g, '<br>')}</div>` : ''}
    </main>
    <footer>Proof of work by ${esc(d.biz)} — made with <a href="https://www.leonlink.net">Proofline</a></footer>`;
  } catch (e) {
    app.innerHTML = `<main class="pub" style="text-align:center;padding:80px 18px"><h1>Report not found</h1><p class="faint">This link may have been deleted.</p></main>`;
  }
}

boot();
</script>
</body></html>
